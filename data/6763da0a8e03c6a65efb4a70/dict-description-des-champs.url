u002F\u002Fwww.w3.org\u002F2006\u002Fvcard\u002Fns#tel","x-concept":{id:"tel",title:"N° de téléphone",primary:c},"x-cardinality":54703},{key:B,"x-originalName":B,type:a,description:"\u003Cp\u003EL'adresse postale de l'établissement\u003C\u002Fp\u003E","x-cardinality":331834},{key:C,"x-originalName":C,type:a,description:"\u003Cp\u003Ecomplément à l'adresse postale, le cas échéant\u003C\u002Fp\u003E","x-cardinality":28159},{key:D,"x-originalName":D,type:a,description:e,"x-refersTo":"http:\u002F\u002Fschema.org\u002FpostalCode","x-concept":{id:"postalCode",title:"Code postal",primary:c},"x-cardinality":7819},{key:E,"x-originalName":E,type:a,description:e,"x-refersTo":"http:\u002F\u002Fschema.org\u002FCity","x-concept":{id:"city",title:"Commune",primary:c},"x-cardinality":59943},{key:m,"x-originalName":m,type:F,description:e,"x-refersTo":"http:\u002F\u002Fschema.org\u002Flatitude","x-concept":{id:m,title:"Latitude",primary:c}},{key:n,"x-originalName":n,type:F,description:e,"x-refersTo":"http:\u002F\u002Fschema.org\u002Flongitude","x-concept":{id:n,title:"Longitude",primary:c}},{key:G,"x-originalName":G,type:a,description:"\u003Cp\u003E\u003Cstrong\u003EValeurs possibles :\u003C\u002Fstrong\u003E \n\u003Cbr \u002F\u003Eess (Acteur de l'économie sociale et solidaire)\n\u003Cbr \u002F\u003EBonusRepar_ASL (Bonus Réparation)\n\u003Cbr \u002F\u003Ebonusrepar_ABJ_TH (Bonus Réparation)\n\u003Cbr \u002F\u003Eecomaison (Bonus Réparation)\n\u003Cbr \u002F\u003Erefashion (Bonus Réparation)\n\u003Cbr \u002F\u003Equalirepar (Bonus Réparation)\n\u003Cbr \u002F\u003Ereparacteur (Chambre des métiers et de l'artisanat)\u003C\u002Fp\u003E","x-cardinality":7,separator:g,title:"Qualités et labels"},{key:H,"x-originalName":H,type:a,description:"\u003Cp\u003E\u003Cstrong\u003EValeurs possibles :\u003C\u002Fstrong\u003E \n\u003Cbr \u002F\u003EParticuliers, \n\u003Cbr \u002F\u003EProfessionnels, \n\u003Cbr \u002F\u003EParticuliers &amp; Professionnels\n\u003Cbr \u002F\u003E[Vide] : à interpréter comme \"Particuliers\"\u003C\u002Fp\u003E","x-cardinality":am,enum:["Particuliers","Particuliers et professionnels"]},{key:I,"x-originalName":I,type:a,description:"\u003Cp\u003E\u003Cstrong\u003EValeurs possibles :\u003C\u002Fstrong\u003E \n\t\u003Cbr \u002F\u003E1 pour 0\n\t\u003Cbr \u002F\u003E1 pour 1 (cela signifie que l'établissement peut reprendre un équipement usagé, uniquement dans le cadre d'un nouvel achat neuf)\u003C\u002Fp\u003E","x-cardinality":am},{key:J,"x-originalName":J,type:K,description:"\u003Cp\u003E\u003Cstrong\u003EValeurs possibles :\u003C\u002Fstrong\u003E \n\u003Cbr \u002F\u003ENon\n\u003Cbr \u002F\u003EOui (cela signifie que l'établissement ne propose des réparations que sur les équipements de sa marque)\u003C\u002Fp\u003E","x-cardinality":an,"x-transform":{expr:e,examples:[e],type:K}},{key:L,"x-originalName":L,type:K,description:"\u003Cp\u003E\u003Cstrong\u003EValeurs possibles :\u003C\u002Fstrong\u003E \n\u003Cbr \u002F\u003Eoui\u003Cbr \u002F\u003E\nnon\u003C\u002Fp\u003E","x-cardinality":an,"x-transform":{expr:e,examples:[e],type:K}},{key:M,"x-originalName":M,type:a,description:"\u003Cp\u003E\u003Cstrong\u003EValeurs possibles :\u003C\u002Fstrong\u003E \u003Cbr \u002F\u003E\nachat_revente_particuliers\u003Cbr \u002F\u003E\nachat_revente_professionnel\u003Cbr \u002F\u003E\nrelai_acteurs_et_evenements\u003Cbr \u002F\u003E\natelier_pour_reparer_soi_meme\u003Cbr \u002F\u003E\ndepot_vente\u003Cbr \u002F\u003E\ndon_particuliers\u003Cbr \u002F\u003E\nechanges_particuliers\u003Cbr \u002F\u003E\nespace_de_partage\u003Cbr \u002F\u003E\nlocaltion_particuliers\u003Cbr \u002F\u003E\nlocation_professionnel\u003Cbr \u002F\u003E\npartage_particuliers\u003Cbr \u002F\u003E\npieces_detachees\u003Cbr \u002F\u003E\nrecyclerie\u003Cbr \u002F\u003E\nservice_de_reparation\u003Cbr \u002F\u003E\nstructure_qui_sous_traite_la_reparation\u003Cbr \u002F\u003E\nstructure_de_collecte\u003Cbr \u002F\u003E\ntutoriels_et_diagnostics_en_ligne\u003Cbr \u002F\u003E\u003C\u002Fp\u003E","x-cardinality":17,separator:g,enum:["structure_de_collecte","service_de_reparation","espace_de_partage","achat_revente_professionnel","recyclerie","location_professionnel","atelier_pour_reparer_soi_meme","depot_vente","pieces_detachees","relai_acteurs_et_evenements","achat_revente_particuliers","tutoriels_et_diagnostics_en_ligne","don_particuliers","localtion_particuliers","echanges_particuliers","partage_particuliers","structure_qui_sous_traite_la_reparation"]},{key:N,"x-originalName":N,type:a,description:"\u003Cp\u003EListe les actions possibles à cette adresse et les catégories d'objets pris en charge.\nUne adresse peut proposer plusieurs actions, et peut prendre en charge plusieurs catégories d'objets. \n\u003Cbr \u002F\u003E\n\u003Cstrong\u003EFormat :\u003C\u002Fstrong\u003E \u003Cbr \u002F\u003E\n[{\"action\":\"action1\",\"sous_categories\":[\"objet1\",\"objet2\"]},{\"action\":\"action2\",\"sous_categories\":[\"objet1\",\"objet2\"]}]\n\u003Cbr \u002F\u003E\n\u003Cstrong\u003EActions possibles :\u003C\u002Fstrong\u003E\u003Cbr \u002F\u003E\npreter\u003Cbr \u002F\u003E\nemprunter\u003Cbr \u002F\u003E\nlouer\u003Cbr \u002F\u003E\nmettre en location\u003Cbr \u002F\u003E\nreparer\u003Cbr \u002F\u003E\nrapporter\u003Cbr \u002F\u003E\ndonner\u003Cbr \u002F\u003E\nechanger\u003Cbr \u002F\u003E\nacheter\u003Cbr \u002F\u003E\nrevendre\u003Cbr \u002F\u003E\ntrier\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003ECatégories possibles - Code :\u003C\u002Fstrong\u003E\u003Cbr \u002F\u003E\naccessoire_et_meuble_de_jardin\t\u003Cbr \u002F\u003E\nampoule\t\u003Cbr \u002F\u003E\nautre_equipement_electronique\t\u003Cbr \u002F\u003E\nautres_pmcb\t\u003Cbr \u002F\u003E\nbateau\t\u003Cbr \u002F\u003E\nbatteries_de_mtl\t\u003Cbr \u002F\u003E\nbatterie_de_voitures_pour_demarrage\t\u003Cbr \u002F\u003E\nbatteries_et_piles_portables\t\u003Cbr \u002F\u003E\nbeton_pmcb_produits_et_materiaux_de_construction_du_batiment\t\u003Cbr \u002F\u003E\nbijou_et_montre\t\u003Cbr \u0