    <meta data-n-head="ssr" charset="utf-8"><meta data-n-head="ssr" name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, minimal-ui"><meta data-n-head="ssr" name="twitter:card" content="summary"><meta data-n-head="ssr" property="og:locale" content="fr_FR"><meta data-n-head="ssr" data-hid="og:image" property="og:image" content="https://data.bretagne-environnement.fr/api/v1/portals/q7t7yA-Mo/assets/home?draft=false&amp;hash=fit-6f7a098dd9.png"><meta data-n-head="ssr" data-hid="og:image:width" property="og:image:width" content="567"><meta data-n-head="ssr" data-hid="og:image:height" property="og:image:height" content="383"><meta data-n-head="ssr" data-hid="description" name="description" content="Indicateurs de tendances climatiques par décennie sur un ensemble de stations Météo France, à partir de séries homogénéisées et de séries quotidiennes de référence. Les tendances sont calculées sur la période 1961-2014 et quand cela est possible, également sur la période 1961-2022. La position des stations Météo France est fournie avec le système de coordonnées WSG84. Les stations sélectionnées couvrent la Bretagne et les SAGE bretons."><meta data-n-head="ssr" property="og:url" content="undefined"><meta data-n-head="ssr" data-hid="og:title" property="og:title" content="Indicateurs climat passé par station en Bretagne : tendances climatiques"><meta data-n-head="ssr" property="og:description" content="Indicateurs de tendances climatiques par décennie sur un ensemble de stations Météo France, à partir de séries homogénéisées et de séries quotidiennes de référence. Les tendances sont calculées sur la période 1961-2014 et quand cela est possible, également sur la période 1961-2022. La position des stations Météo France est fournie avec le système de coordonnées WSG84. Les stations sélectionnées couvrent la Bretagne et les SAGE bretons."><meta data-n-head="ssr" property="og:type" content="article"><meta data-n-head="ssr" property="article:author" content="Observatoire de l&#x27;environnement en Bretagne"><meta data-n-head="ssr" property="article:modified_time" content="2025-02-24T14:21:03.014Z"><meta data-n-head="ssr" property="article:published_time" content="2025-02-24T14:21:03.014Z"><title>Indicateurs climat passé par station en Bretagne : tendances climatiques</title><base href="/"><link data-n-head="ssr" rel="canonical" href="https://data.bretagne-environnement.fr/datasets/indicateurs-climat-passe-tendances-climatiques-en-bretagne-par-station-meteo"><link data-n-head="ssr" rel="icon" type="image/x-icon" href="https://data.bretagne-environnement.fr/api/v1/portals/q7t7yA-Mo/assets/favicon?draft=false&amp;hash=51d90e7c54"><link data-n-head="ssr" rel="stylesheet" href="https://fonts.googleapis.com/css?family=Lato|Lato&amp;display=swap"><style data-n-head="ssr" vmid="config-style" type="text/css">
html {
  overflow-y: scroll !important;
}

.v-application#app.theme--light#app {
  background: #FAFAFA;
}

.v-btn.primary.theme--light.v-btn--has-bg {
  background: linear-gradient(90deg, #2b7c8a 0%, #1f5963 100%);
}

/* TODO: the next 3 rules should be deprecated and replaced by explicit coloring of buttons in components (as done in nav-link component) */
.v-application#app.theme--light .v-btn.primary.v-btn--has-bg {
  border: 1px solid #1f5963 !important;
}
.v-btn.secondary.theme--light.v-btn--has-bg {
  background-color: #1775c8 !important;
}
.v-btn.tertiary.theme--light.v-btn--has-bg {
  background-color: #1775c8 !important;
}

/* Apply fonts */



    .v-application#app {
    font-family: "Lato", sans-serif !important;
    }
    .v-application#app .text-subtitle-1, .v-application#app .text-subtitle-2, .v-application#app .text-body-1, .v-application#app .text-button, .v-application#app .text-caption, .v-application#app .text-overline  {
    font-family: "Lato", sans-serif !important;
    }
    .v-application#app .text-h1, .v-application#app .text-h2, .v-application#app .text-h3, .v-application#app .text-h4, .v-application#app .text-h5, .v-application#app .text-h6 {
    font-family: "Lato", sans-serif !important;
    }

    /* older typography classes */
    .v-application#app .subheading, .v-application#app .body-2, .v-application#app .body-1, .v-application#app .button, .v-application#app .caption, .v-application#app .overline {
    font-family: "Lato", sans-serif !important;
    }
    .v-application#app .display-4, .v-application#app .display-3, .v-application#app .display-2, .v-application#app .display-1, .v-application#app .headline, .v-application#app .title {
    font-family: "Lato", sans-serif !important;
    }
      

      .v-application#app a {
        text-decoration: none;
      }


/* some police tuning */
.v-application#app a:not(.v-tab):not(.v-list-item):not(.v-card--link) {
  color: #2b7c8a;
}
.v-application#app a:not(.v-tab):not(.v-list-item):not(.v-card--link):hover {
  color: #1f5963;
}
.v-application#app .area--dark a,
.v-application#app .area--dark a:not(.v-tab):not(.v-list-item):not(.v-card--link),
.v-application#app .area--dark a:not(.v-tab):not(.v-list-item):not(.v-card--link):hover,
.v-application#app .area--dark h3,
.v-application#app .area--dark span {
  color: white;
}
.v-application#app .v-btn:not(.v-btn--outlined).primary,
.v-application#app .v-btn:not(.v-btn--outlined).secondary,
.v-application#app .v-btn:not(.v-btn--outlined).accent,
