,label:"Police 1 (Marianne-Regular.woff2)"};bb.appBarTransparency=c;bb.appBarBehavior="stick";bb.appBarColor=q;bb.appBarActiveOptions=["slider","color"];bb.appBarFluid=c;bb.appBarFontColorPrimary=b;bb.appBarAdditionalLinks=[];bb.website=bf;bb.titleColor=bg;bb.headerColor="page";bb.headerNoTitle=b;bb.useHtmlTitle=b;bb.headerLogo2="https:\u002F\u002Fcellule-strategie-numerique-adem.gitbook.io\u002F~gitbook\u002Fimage?url=https:%2F%2F4251515518-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252F2jK8JaUieA84hk2TJR3v%252Fuploads%252FjiBdH9uzuChCqRrgYFTU%252FLogo%2520Fabrique%2520-%2520small.jpg%3Falt=media%26token=50c7bfac-218c-4947-8dec-13efab2749c3&width=768&dpr=1&quality=100&sign=4aab3d5169efc1409f0e3aa8ad197f26b472b5c5bdf2d4a28515a21abca1a87d";bb.headerHide=c;bb.footerColor="#FFFFFF";bb.footerLinks=[{type:r,href:"https:\u002F\u002Fagirpourlatransition.ademe.fr\u002Fconditions-generales-dutilisation",title:"Conditions d'utilisation"},{type:r,href:bf,title:"Site institutionnel"},{type:r,href:"https:\u002F\u002Fwww.ademe.fr\u002Fcontent\u002Fcontacter",title:"Nous contacter"},{type:r,title:" Agir pour la transition écologique",href:"https:\u002F\u002Fagirpourlatransition.ademe.fr\u002F"},{type:r,title:"Twitter",href:"https:\u002F\u002Ftwitter.com\u002Fademe"}];bb.footerImportantLinks=[];bb.footerExtraLogos=[];bb.footerLinksMode="columns";bb.footerCopyrightAsLogo=b;bb.footerSocial=c;bb.footerBackgroundImage=h;bb.footerSitemap=b;bb.footerPrivacyPolicy=c;bb.homeImageAsBanner=b;bb.description="\u003Cp\u003EÉtablissement public à caractère industriel et commercial, placé sous la tutelle conjointe des ministères en charge de la Transition écologique et solidaire et de l’Enseignement supérieur et de la Recherche, l’ADEME participe à la mise en œuvre des politiques publiques dans les domaines de l’environnement, de l’énergie et du développement durable.\u003C\u002Fp\u003E\n\u003Cp\u003EPour répondre aux obligations réglementaires (Loi pour une République numérique) mais également pour accompagner la Transition écologique, l’Agence a décidé de mettre à disposition des entreprises, des collectivités locales, des pouvoirs publics et du grand public, ses données afin de leur permettre de progresser dans leur démarche environnementale et de démultiplier les actions en faveur de la Transition écologique.\u003C\u002Fp\u003E\n\u003Cp\u003ELes données de prospective \"Transition(s) 2050\" sont accessibles sur le portail \u003Ca href=\"https:\u002F\u002Fdata-transitions2050.ademe.fr\"\u003Edata-transitions2050.ademe.fr\u003C\u002Fa\u003E\u003C\u002Fp\u003E\n";bb.showKpis=c;bb.homeDatasets={type:bh,size:o,cardLayout:s};bb.homeApplications={type:bh,size:o,cardLayout:s};bb.showTwitterTimeline=c;bb.kpiBackgroundColor=q;bb.kpiOptions=[j,"shaped"];bb.homeImageHidden=b;bb.homeSearchPosition=aA;bb.homeTopicsPosition=aA;bb.homeShowSearch=b;bb.homeShowTopics=c;bb.homeTopicsOptions=[j,bi,bj];bb.homeSearchOptions=[j,bi];bb.homeLinksOptions=[j,bj];bb.homeLinks=[];bb.homeShowLinks=b;bb.showLastNews=b;bb.homeLinksPosition=aA;bb.showEvents=b;bb.homeTemplate={type:aB};bb.datasetThumbnailContain=b;bb.datasetsPage={type:bk};bb.datasetsDefaultSort=bl;bb.datasetsCardLayout=s;bb.datasetThumbnailApplication=b;bb.datasetMetaLayout="columnsLeftLarger";bb.datasetActionsDisplay=bm;bb.datasetsOwnerFilter={type:h};bb.datasetHideDepartment=c;bb.applicationsPage={type:bk};bb.applicationsCardLayout=s;bb.applicationsDirectNavigation=b;bb.applicationActionsDisplay=bm;bb.applicationsDefaultSort=bl;bb.applicationHideDepartment=c;bb.externalReusesPage={type:h};bb.usesPage={type:h};bb.usesManagement={type:"managers"};bb.usesCardLayout=s;bb.newsPage={type:h};bb.eventsPage={type:h};bb.contactEmail="cdo@ademe.fr";bb.contactFooterColor=bg;bb.networks=["twitter","linkedin","reddit","facebook","whatsapp"];bb.personalNavigationColor=bd;bb.personalAccountPages=[];bb.personnalHidePages=[];bb.analytics={type:h};bb.updatedAt="2025-10-13T13:57:39.535Z";bb.owner={