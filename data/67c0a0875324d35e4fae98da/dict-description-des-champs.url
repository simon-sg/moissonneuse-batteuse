r=R;L.headerColor="page";L.headerNoTitle=b;L.useHtmlTitle=b;L.headerLogo2="https:\u002F\u002Fcellule-strategie-numerique-adem.gitbook.io\u002F~gitbook\u002Fimage?url=https:%2F%2F4251515518-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252F2jK8JaUieA84hk2TJR3v%252Fuploads%252FjiBdH9uzuChCqRrgYFTU%252FLogo%2520Fabrique%2520-%2520small.jpg%3Falt=media%26token=50c7bfac-218c-4947-8dec-13efab2749c3&width=768&dpr=1&quality=100&sign=4aab3d5169efc1409f0e3aa8ad197f26b472b5c5bdf2d4a28515a21abca1a87d";L.headerHide=a;L.footerColor="#FFFFFF";L.footerLinks=[{type:j,href:"https:\u002F\u002Fagirpourlatransition.ademe.fr\u002Fconditions-generales-dutilisation",title:"Conditions d'utilisation"},{type:j,href:Q,title:"Site institutionnel"},{type:j,href:"https:\u002F\u002Fwww.ademe.fr\u002Fcontent\u002Fcontacter",title:"Nous contacter"},{type:j,title:" Agir pour la transition écologique",href:"https:\u002F\u002Fagirpourlatransition.ademe.fr\u002F"},{type:j,title:"Twitter",href:"https:\u002F\u002Ftwitter.com\u002Fademe"}];L.footerImportantLinks=[];L.footerExtraLogos=[];L.footerLinksMode="columns";L.footerCopyrightAsLogo=b;L.footerSocial=a;L.footerBackgroundImage=f;L.footerSitemap=b;L.footerPrivacyPolicy=a;L.homeImageAsBanner=b;L.description="\u003Cp\u003EÉtablissement public à caractère industriel et commercial, placé sous la tutelle conjointe des ministères en charge de la Transition écologique et solidaire et de l’Enseignement supérieur et de la Recherche, l’ADEME participe à la mise en œuvre des politiques publiques dans les domaines de l’environnement, de l’énergie et du développement durable.\u003C\u002Fp\u003E\n\u003Cp\u003EPour répondre aux obligations réglementaires (Loi pour une République numérique) mais également pour accompagner la Transition écologique, l’Agence a décidé de mettre à disposition des entreprises, des collectivités locales, des pouvoirs publics et du grand public, ses données afin de leur permettre de progresser dans leur démarche environnementale et de démultiplier les actions en faveur de la Transition écologique.\u003C\u002Fp\u003E\n\u003Cp\u003ELes données de prospective \"Transition(s) 2050\" sont accessibles sur le portail \u003Ca href=\"https:\u002F\u002Fdata-transitions2050.ademe.fr\"\u003Edata-transitions2050.ademe.fr\u003C\u002Fa\u003E\u003C\u002Fp\u003E\n";L.showKpis=a;L.homeDatasets={type:S,size:A,cardLayout:k};L.homeApplications={type:S,size:A,cardLayout:k};L.showTwitterTimeline=a;L.kpiBackgroundColor=i;L.kpiOptions=[g,"shaped"];L.homeImageHidden=b;L.homeSearchPosition=B;L.homeTopicsPosition=B;L.homeShowSearch=b;L.homeShowTopics=a;L.homeTopicsOptions=[g,T,U];L.homeSearchOptions=[g,T];L.homeLinksOptions=[g,U];L.homeLinks=[];L.homeShowLinks=b;L.showLastNews=b;L.homeLinksPosition=B;L.showEvents=b;L.homeTemplate={type:C};L.datasetThumbnailContain=b;L.datasetsPage={type:V};L.datasetsDefaultSort=W;L.datasetsCardLayout=k;L.datasetThumbnailApplication=b;L.datasetMetaLayout="columnsLeftLarger";L.datasetActionsDisplay=X;L.datasetsOwnerFilter={type:f};L.datasetHideDepartment=a;L.applicationsPage={type:V};L.applicationsCardLayout=k;L.applicationsDirectNavigation=b;L.applicationActionsDisplay=X;L.applicationsDefaultSort=W;L.applicationHideDepartment=a;L.externalReusesPage={type:f};L.usesPage={type:f};L.usesManagement={type:"managers"};L.usesCardLayout=k;L.newsPage={type:f};L.eventsPage={type:f};L.contactEmail="cdo@ademe.fr";L.contactFooterColor=R;L.networks=["twitter","linkedin","reddit","facebook","whatsapp"];L.personalNavigationColor=O;L.personalAccountPages=[];L.personnalHidePages=[];L.analytics={type:f};L.updatedAt="2025-10-13T13:57:39.535Z";L.owner={type:D,id:E,name:x};Y._id="efWMeL1ZP";$[0]="organization:mMqHP1AmF";ac[0]={_id:"6a301167ab8168b8b75456b6",updated:{date:"2026-06-24T09:03:32.074Z"},navigation:{type:ad,position:ae},template:af,title:"Accès MCP",id:"acces-mcp"};ac[1]={_id:"6717558f1adfd05460cc16b2",updated:{date:"2024-11-05T14:53:01.669Z"},navigation:{type:ad,position:ae},template:af,title:"FAQ",id:"faq"};return {layout:C,data:[{}],fetch:{"0":{},"1":{isMobileOnly:b,dataset:{title:"Consommation des bâtiments tertiaires par vecteur énergétique",owner:{type:D,id:E,name:x,department:"departement-batiment",departmentName:"Département Bâtiment"},updatedAt:"2026-06-30T10:17:05.989Z",createdAt:"2024-08-20T14:27:27.942Z",updatedBy:{id:"apiKey:qehQ6oYerTmgAC2SDwvPh",name:"SYDEREP"},createdBy:{id:"Z6s26WHJF",name:"Chady Nassar"},schema:[{key:l,"x-originalName":l,type:c,"x-cardinality":5,description:"\u003Cp\u003EL'année pour laquelle les déclarations de consommations ont été effectuées.\nL' « année de référence » correspond à une année de consommation entre 2010 et 2019. Les assujettis ne déclarent qu'une seule année de consommation sur cette période par EFA, et choisissent pour chacune l'année la plus représentative de cette période en termes de consommation d'énergie. Le millésime de ces déclarations n'est donc pas unique. Celles-ci sont regroupées sous le libellé : 'année de référence'.\u003C\u002Fp\u003E",title:"Année de consommation",enum:["2021","2020","2022","0 - année de référence","2023"]},{key:m,"x-originalName":m,type:c,"x-cardinality":14,description:"\u003Cp\u003EZone climatique. Le terme \"ND\" correspond à \"non divulguée\" et concerne les EFA dont la zone climatique ne peut être divulguée afin de respecter le secret des affaires.\u003C\u002Fp\u003E",title:"Zone climatique",enum:["H1a","H1c","H2b","H1b","H2c","H3","H2a","H2d","REU","GUA","MAR","GUY","MAY",n]},{key:o,"x-originalName":o,type:c,"x-cardinality":F,description:"\u003Cp\u003ECode de la région. Le terme \"ND\" correspond à \"non divulguée\" et concerne des EFA dont la région ne peut être divulguée par respect pour le secret des affaires.\u003C\u002Fp\u003E",title:"Code région",enum:["84","11","75","44","32","76","52","53","27","28","93","24","94","04","01","02",n,"03","06","00"]},{key:p,"x-originalName":p,type:c,"x-cardinality":F,description:"\u003Cp\u003ENom de la région. Le terme \"ND\" correspond à \"non divulguée\" et concerne des EFA dont la région ne peut être divulguée par respect pour le secret des affaires.\u003C\u002Fp\u003E",title:"Nom région",enum:["Auvergne-Rhône-Alpes","Île-de-France","Nouvelle-Aquitaine","Grand-Est","Hauts-de-France","Occitanie","Pays de la Loire","Bretagne","Bourgogne-Franche-Comté","Normandie","Provence-Alpes-Côte d'Azur","Centre-Val de Loire","Corse","La Réunion","Guadeloupe","Martinique",n,"Guyane","Mayotte","Collectivités d'Outre-Mer"]},{key:q,"x-originalName":q,type:c,"x-cardinality":G,description:"\u003Cp\u003ECode du département. Le terme \"ND\" correspond à \"non divulgué\" et concerne des EFA dont le département ne peut être divulgué par respect pour le secret des affaires.\u003C\u002Fp\u003E",title:"Code département\t"},{key:r,"x-originalName":r,type:c,"x-cardinality":G,description:"\u003Cp\u003ENom du département. Le terme \"ND\" correspond à \"non divulgué\" et concerne des EFA dont le département ne peut être divulgué par respect pour le secret des affaires.\u003C\u002Fp\u003E",title:"Nom département"},{key:s,"x-originalName":s,type:c,"x-cardinality":7315,description:"\u003Cp\u003ENom de la commune. Le terme \"ND\" correspond à \"non divulgué\" et concerne des EFA dont la commune ne peut être divulguée par respect pour le secret des affaires.\u003C\u002Fp\u003E",title:"Nom commune"},{key:t,"x-originalName":t,type:c,"x-cardinality":8,description:"\u003Cp\u003EType d'énergie consommée par les EFA. Le terme \"ND\" correspond à \"non divulgué\" et concerne des EFA dont le vecteur énergétique ne peut être divulgué par respect pour le secret des affaires.\u003C\u002Fp\u003E",title:"Vecteur énergétique",enum:["Electricite","Gaz",n,"Fioul","Reseau de chaleur","Bois","Reseau de froid","Gazole non routier"]},{key:u,"x-originalName":u,type:v,"x-cardinality":57705,description:"\u003Cp\u003EConsommation des EFA déclarée en kWh PCI. La consommation de l'EFA le plus énergivore ne peut excéder 85 % de la consommation déclarée par respect pour le secret des affaires.\u003C\u002Fp\u003E",title:"Consommation déclarée (kWh)"},{"x-calculated":a,key:"_id",type:c,format:"uri-reference",title:"Identifiant",description:"\u003Cp\u003EIdentifiant unique parmi toutes les lignes du jeu de données\u003C\u002Fp\u003E"},{"x-calculated":a,key:"_i",type:v,title:"Numéro de ligne",description:"\u003Cp\u003EIndice de la ligne dans le fichier d'origine\u003C\u002Fp\u003E"},{"x-calculated":a,key:"_rand",type:v,title:"Nombre aléatoire",description:"\u003Cp\u003EUn nombre aléatoire associé à la ligne qui permet d'obtenir un tri aléatoire par exemple\u003C\u002Fp\u003E"}],status:"finalized",id:"xcx6xs6uahu6z6wzj7xqiacu",slug:"consommation-tertiaire-vecteur-energetique",dataUpdatedAt:"2025-05-15T06:54:17.343Z",dataUpdatedBy:{id:"4YEaSXana",name:"Thibault GAUDUCHON"},file:{name:y,size:h,mimetype:z,md5:H,encoding:I,schema:[{key:l,"x-originalName":l,type:c},{key:m,"x-originalName":m,type:c},{key:o,"x-originalName":o,type:c},{key:p,"x-originalName":p,type:c},{key:q,"x-originalName":q,type:c},{key:r,"x-originalName":r,type:c},{key:s,"x-originalName":s,type:c},{key:t,"x-originalName":t,type:c},{key:u,"x-originalName":u,type:v}],props:{linesDelimiter:"\r\n",fieldsDelimiter:",",escapeChar:J,quote:J}},originalFile:{name:y,size:h,mimetype:z,md5:H,encoding:I},storage:{size:h,dataFiles:[{name:y,key:"original",title:"Fichier d'origine",mimetype:z,size:h,updatedAt:"2025-05-15T06:54:16.628Z"}],indexed:{size:h,parts:["original-file"]},attachments:{size:e,count:e},metadataAttachments:{size:e,count:e},masterData:{size:e,count:e}},count:58053,finalizedAt:"2025-05-15T06:55:11.092Z",description:"\u003Cp\u003ELes déclarations de consommations sont \u003Cstrong\u003Eagrégées\u003C\u002Fstrong\u003E (sommées) à la maille \u003Cstrong\u003Ecommunale\u003C\u002Fstrong\u003E et par type d'énergie (\u003Cstrong\u003Eélectricité, gaz, fioul…\u003C\u002Fstrong\u003E). Aucune données de surface n'est disponible, puisque seule la consommation totale des bâtiments « tous vecteurs confondus » est associée à leur surface. Les données regroupant trop peu de déclarations sont « non divulguées » (ND) afin de respecter le secret des affaires. \u003C\u002Fp\u003E\n\u003Ch2\u003ELe dispositif Éco Énergie Tertiaire (EET)\u003C\u002Fh2\u003E\n\u003Cp\u003E\u003Ca href=\"https:\u002F\u002Fwww.ecologie.gouv.fr\u002Feco-energie-tertiaire-eet\"\u003ELe dispositif Éco Énergie Tertiaire (EET)\u003C\u002Fa\u003E est une obligation réglementaire qui engage tous les acteurs du tertiaire vers la sobriété énergétique. Issue du décret tertiaire (article 175 de la loi Élan), elle impose une réduction progressive de la consommation d’énergie dans les bâtiments à usage tertiaire afin de lutter contre le changement climatique.\u003C\u002Fp\u003E\n\u003Ch2\u003ELa plateforme OPERAT de collecte des données par l’Ademe\u003C\u002Fh2\u003E\n\u003Cp\u003E\u003Ca href=\"https:\u002F\u002Foperat.ademe.fr\u002F#\u002Fpublic\u002Fhome\"\u003ELa plateforme OPERAT\u003C\u002Fa\u003E est la plateforme de suivi de l’exigence réglementaire mise en place dans le cadre du dispositif EET. Elle a pour objectif de répondre aux exigences réglementaires de collecte de données (bâtiments, consommations…). Elle permet de vérifier l’atteinte des objectifs réglementaires. A terme, elle diffusera et valorisera les données collectées. Elle est développée par l’Ademe.\u003C\u002Fp\u003E\n\u003Ch2\u003ELes données à votre disposition\u003C\u002Fh2\u003E\n\u003Cp\u003ELes données à disposition ici concernent les déclarations de consommation énergétique effectuées par les assujettis au dispositif EET. Ces déclarations sont réalialisées annuellement sur une période de reporting choisie par l’assujetti et à la maille bâtimentaire de l'\u003Cem\u003EEntité fonctionnelle assujettie\u003C\u002Fem\u003E (EFA). Une EFA est une entité correspondant à un établissement au sens de la définition de l’Institut national de la statistique et des études économiques (INSEE) (voir \u003Ca href=\"https:\u002F\u002Foperat.ademe.fr\u002F#\u002Fpublic\u002Ffaq#question_3\"\u003EFAQ OPERAT\u003C\u002Fa\u003E).\u003C\u002Fp\u003E\n\u003Cp\u003ECes déclarations intègrent notamment les données énergétiques de consommations, les catégories d’activités et les surfaces associées.\nSur ces pages, vous pouvez accéder aux déclarations de consommations agrégées (sommées) présentes dans la base de données OPERAT. \u003Cstrong\u003EVous retrouverez uniquement les déclarations de consommations validées par les déclarants\u003C\u002Fstrong\u003E.\nSur ces pages, vous avez accès : \u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003EAux \u003Cstrong\u003Edonnées agrégées\u003C\u002Fstrong\u003E (sommées) sous forme d’un jeu de données\u003C\u002Fli\u003E\n\u003Cli\u003EA des visualisations associées\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Cp\u003ECes données peuvent être comparées avec les données du parc tertiaire français fournies par le Centre d’études et de recherches économiques sur l’énergie (CEREN) :\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003ESurface totale tertiaire : 1 233 Mm²\u003C\u002Fli\u003E\n\u003Cli\u003ESurface totale tertiaire assujetti au dispositif EET : 996 Mm²\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Cp\u003EL'Ademe propose une analyse des données déclarées dans OPERAT par le biais d'un rapport de bilan de l'utilisation de la plateforme \u003Ca href=\"https:\u002F\u002Flibrairie.ademe.fr\u002F7242-performance-energetique-du-parc-tertiaire-quel-bilan-de-l-utilisation-de-la-plateforme-operat-en-2022-2023-.html\"\u003Econsultable ici\u003C\u002Fa\u003E\u003C\u002Fp\u003E\n\u003Ch2\u003EPrécautions d’interprétation des données\u003C\u002Fh2\u003E\n\u003Cp\u003EAttention : les données fournies ici sont des données agrégées d’OPERAT (sommées) afin d’afficher des données anonymes respectant le secret des affaires (grappe minimale de 3 valeurs, une déclaration ne doit pas dépasser 85 % du volume). \u003Cstrong\u003ELes données de consommation ne sont pas corrigées climatiquement\u003C\u002Fstrong\u003E pour le moment (développement en cours). \nLeurs réutilisations et interprétations doivent être faites avec précaution. En effet, OPERAT est ouvert à toutes les parties prenantes d’un local (propriétaire, locataire, gestionnaire tiers), il est possible que des doublons de déclarations existent mais aussi que des données (surfaces, énergies) soient erronées. \nL’Ademe n’effectue qu’un contrôle de cohérence large. Dans ce cadre, l’Ademe ne peut en aucun cas être tenue responsable de la qualité des données qui lui sont transmises.\nPour en savoir plus sur le contrôle de cohérence effectué, nous vous invitons à consulter la page 6 du rapport de bilan de l'utilisation de la plateforme OPERAT \u003Ca href=\"https:\u002F\u002Flibrairie.ademe.fr\u002F7242-performance-energetique-du-parc-tertiaire-quel-bilan-de-l-utilisation-de-la-plateforme-operat-en-2022-2023-.html\"\u003Econsultable ici\u003C\u002Fa\u003E\u003C\u002Fp\u003E\n\u003Ch2\u003EMise à jour des données\u003C\u002Fh2\u003E\n\u003Cp\u003ELes données ont été extraites au \u003Cstrong\u003E18\u002F04\u002F25\u003C\u002Fstrong\u003E. A l'avenir, elles seront mises à jour régulièrement.\u003C\u002Fp\u003E",license:{title:"Licence Ouverte \u002F Open Licence",href:"https:\u002F\u002Fwww.etalab.gouv.fr\u002Flicence-ouverte-open-licence"},topics:[{title:K,color:"#64B5F6FF",id:"fJZXrdcRGP",icon:{name:"domain-plus",svgPath:"M12 7V3H2V21H13.35A5.8 5.8 0 0 1 13 19H12V17H13.35A5 5 0 0 1 14 15.69V15H12V13H14V11H12V9H20V13.09A5.58 5.58 0 0 1 22 13.81V7M6 19H4V17H6M6 15H4V13H6M6 11H4V9H6M6 7H4V5H6M10 19H8V17H10M10 15H8V13H10M10 11H8V9H10M10 7H8V5H10M16 13H18V11H16M16 11V13H18V11M16 11V13H18V11M20 15V18H23V20H20V23H18V20H15V18H18V15Z"}}],spatial:"Nationale",frequency:"irregular",origin:x,publicationSites:["data-fair-portals:46b4f014-0b00-4640-b5a8-4eb7d4c3b8e1","data-fair-portals:efWMeL1ZP","data-fair-portals:d60479cb-366f-4dc4-9f3f-1e9dd1a76c97"],requestedPublicationSites:[],extras:{applications:[{updatedAt:"2024-09-06T08:24:55.867Z",id:"XMScy94zvOtLWLARddHIA",slug:"repartition-de-la-consommation-declaree-2021"},{updatedAt:"2024-09-11T08:18:49.662Z",id:"R8UBGBu7wdQ9QDUxRxdSN",slug:"repartition-consommation-declaree-2021"},{updatedAt:"2025-04-28T15:22:50.411Z",id:"_ti3oGf_Ug6EX30D0dIm7",slug:"graphiques-divers-2"}]},publications:[],keywords:[K],userPermissions:["list","readDescription","readSchema","readSafeSchema","readLines","getGeoAgg","getValuesAgg","getValues","getMetricAgg","getSimpleMetricsAgg","getWordsAgg","getMinAgg","getMaxAgg","downloadOriginalData","downloadFullData","readApiDoc","realtime-transactions","readLine","readLineRevisions","readRevisions","bulkSearch","listDataFiles","downloadDataFile","downloadMetadataAttachment","downloadAttachment","getReadApiKey","readCompatODSRecords","readCompatODSExports"],public:a,visibility:"public",previews:[{id:"table",title:"Tableau",href:"https:\u002F\u002Fdata.ademe.fr\u002Fdata-fair\u002Fembed\u002Fdataset\u002Fconsommation-tertiaire-vecteur-energetique\u002Ftable"}],href:"https:\u002F\u002Fdata.ademe.fr\u002Fdata-fair\u002Fapi\u002Fv1\u002Fdatasets\u002Fconsommation-tertiaire-vecteur-energetique",page:"https:\u002F\u002Fdata.ademe.fr\u002Fdatasets\u002Fconsommation-tertiaire-vecteur-energetique"},applications:{count:e,results:[]},uses:[]}},error:d,state:{config:L,portal:Y,draft:b,initialQuery:Z,textDark:"#212121",breadcrumbs:d,publicUrl:w,publicBaseUrl:w,mainPublicUrl:_,html:a,inPortal:a,concepts:d,userPartners:d,whiteLabelOwners:$,childBreadcrumbsRouteName:d,childBreadcrumbItems:d,processingsBasePath:aa,notifyBasePath:ab,pageImages:{},navigation:{pages:ac,datasetsList:d,applicationsList:d,usesList:d,publicUrl:w,publicBaseUrl:w,mainPublicUrl:_,processingsBasePath:aa,notifyBasePath:ab,initialQuery:Z,draft:b,portal:Y,html:a,inPortal:a,config:L,whiteLabelOwners:$},style:{},session:{user:d,initialized:a,directoryUrl:"https:\u002F\u002Fdat