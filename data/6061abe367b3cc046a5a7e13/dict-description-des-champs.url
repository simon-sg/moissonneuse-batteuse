dColor=I;ed.actionCardOptions=["hoverElevate",C];ed.radius=g;ed.elevation=f;ed.backgroundColor=I;ed.secondaryBackgroundColor="#AAA1A1";ed.secondaryColor=ee;ed.topicsBackgroundColor="individual";ed.actionCardHorizontalOptions=[C,"flat","hoverColorTitle","hoverColorBorder"];ed.actionCardHorizontalBackgroundColor=I;ed.navLinkMode="link";ed.navLinkColor=ef;ed.tertiaryColor=ee;ed.headingsFont={source:eg,name:"font2",label:"Police 2 (Marianne-Bold.woff2)"};ed.bodyFont={source:eg,name:"font1",label:"Police 1 (Marianne-Regular.woff2)"};ed.appBarTransparency=c;ed.appBarBehavior="stick";ed.appBarColor=I;ed.appBarActiveOptions=["slider","color"];ed.appBarFluid=c;ed.appBarFontColorPrimary=i;ed.appBarAdditionalLinks=[];ed.website=eh;ed.titleColor=ei;ed.headerColor="page";ed.headerNoTitle=i;ed.useHtmlTitle=i;ed.headerLogo2="https:\u002F\u002Fcellule-strategie-numerique-adem.gitbook.io\u002F~gitbook\u002Fimage?url=https:%2F%2F4251515518-files.gitbook.io%2F%7E%2Ffiles%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252F2jK8JaUieA84hk2TJR3v%252Fuploads%252FjiBdH9uzuChCqRrgYFTU%252FLogo%2520Fabrique%2520-%2520small.jpg%3Falt=media%26token=50c7bfac-218c-4947-8dec-13efab2749c3&width=768&dpr=1&quality=100&sign=4aab3d5169efc1409f0e3aa8ad197f26b472b5c5bdf2d4a28515a21abca1a87d";ed.headerHide=c;ed.footerColor="#FFFFFF";ed.footerLinks=[{type:J,href:"https:\u002F\u002Fagirpourlatransition.ademe.fr\u002Fconditions-generales-dutilisation",title:"Conditions d'utilisation"},{type:J,href:eh,title:"Site institutionnel"},{type:J,href:"https:\u002F\u002Fwww.ademe.fr\u002Fcontent\u002Fcontacter",title:"Nous contacter"},{type:J,title:" Agir pour la transition écologique",href:"https:\u002F\u002Fagirpourlatransition.ademe.fr\u002F"},{type:J,title:"Twitter",href:"https:\u002F\u002Ftwitter.com\u002Fademe"}];ed.footerImportantLinks=[];ed.footerExtraLogos=[];ed.footerLinksMode="columns";ed.footerCopyrightAsLogo=i;ed.footerSocial=c;ed.footerBackgroundImage=w;ed.footerSitemap=i;ed.footerPrivacyPolicy=c;ed.homeImageAsBanner=i;ed.description="\u003Cp\u003EÉtablissement public à caractère industriel et commercial, placé sous la tutelle conjointe des ministères en charge de la Transition écologique et solidaire et de l’Enseignement supérieur et de la Recherche, l’ADEME participe à la mise en œuvre des politiques publiques dans les domaines de l’environnement, de l’énergie et du développement durable.\u003C\u002Fp\u003E\n\u003Cp\u003EPour répondre aux obligations réglementaires (Loi pour une République numérique) mais également pour accompagner la Transition écologique, l’Agence a décidé de mettre à disposition des entreprises, des collectivités locales, des pouvoirs publics et du grand public, ses données afin de leur permettre de progresser dans leur démarche environnementale et de démultiplier les actions en faveur de la Transition écologique.\u003C\u002Fp\u003E\n\u003Cp\u003ELes données de prospective \"Transition(s) 2050\" sont accessibles sur le portail \u003Ca href=\"https:\u002F\u002Fdata-transitions2050.ademe.fr\"\u003Edata-transitions2050.ademe.fr\u003C\u002Fa\u003E\u003C\u002Fp\u003E\n";ed.showKpis=c;ed.homeDatasets={type:ej,size:f,cardLayout:K};ed.homeApplications={type:ej,size:f,cardLayout:K};ed.showTwitterTimeline=c;ed.kpiBackgroundColor=I;ed.kpiOptions=[C,"shaped"];ed.homeImageHidden=i;ed.homeSearchPosition=cx;ed.homeTopicsPosition=cx;ed.homeShowSearch=i;ed.homeShowTopics=c;ed.homeTopicsOptions=[C,ek,el];ed.homeSearchOptions=[C,ek];ed.homeLinksOptions=[C,el];ed.homeLinks=[];ed.homeShowLinks=i;ed.showLastNews=i;ed.homeLinksPosition=cx;ed.showEvents=i;ed.homeTemplate={type:cy};ed.datasetThumbnailContain=i;ed.datasetsPage={type:em};ed.datasetsDefaultSort=en;ed.datasetsCardLayout=K;ed.datasetThumbnailApplication=i;ed.datasetMetaLayout="columnsLeftLarger";ed.datasetActionsDisplay=eo;ed.datasetsOwnerFilter={type:w};ed.datasetHideDepartment=c;ed.applicationsPage={type:em};ed.applicationsCardLayout=K;ed.applicationsDirectNavigation=i;ed.applicationActionsDisplay=eo