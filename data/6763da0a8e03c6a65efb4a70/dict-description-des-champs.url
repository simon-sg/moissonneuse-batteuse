      .card-gradient-desc70 {
        position: relative;
      }
      .card-gradient-desc70:before {
        content:'';
        position:absolute;
        width:100%;
        height:70px;
        left:0;
        top:0;
        background:linear-gradient(transparent 0, transparent 43%, #FAFAFA);
      }
      

/* footer style */


/* home page style */
#app .nav-home-search input::placeholder {
  color: #0d47a2;
  font-weight: bold;
}
#app .nav-home-search .v-input__icon--append button {
  color: #0d47a2;
}
