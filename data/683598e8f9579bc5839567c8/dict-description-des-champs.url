tivités locales, des pouvoirs publics et du grand public, ses données afin de leur permettre de progresser dans leur démarche environnementale et de démultiplier les actions en faveur de la Transition écologique.\u003C\u002Fp\u003E\n\u003Cp\u003ELes données de prospective \"Transition(s) 2050\" sont accessibles sur le portail \u003Ca href=\"https:\u002F\u002Fdata-transitions2050.ademe.fr\"\u003Edata-transitions2050.ademe.fr\u003C\u002Fa\u003E\u003C\u002Fp\u003E\n";af.showKpis=b;af.homeDatasets={type:al,size:r,cardLayout:k};af.homeApplications={type:al,size:r,cardLayout:k};af.showTwitterTimeline=b;af.kpiBackgroundColor=i;af.kpiOptions=[g,"shaped"];af.homeImageHidden=c;af.homeSearchPosition=s;af.homeTopicsPosition=s;af.homeShowSearch=c;af.homeShowTopics=b;af.homeTopicsOptions=[g,am,an];af.homeSearchOptions=[g,am];af.homeLinksOptions=[g,an];af.homeLinks=[];af.homeShowLinks=c;af.showLastNews=c;af.homeLinksPosition=s;af.showEvents=c;af.homeTemplate={type:t};af.datasetThumbnailContain=c;af.datasetsPage={type:ao};af.datasetsDefaultSort=ap;af.datasetsCardLayout=k;af.datasetThumbnailApplication=c;af.datasetMetaLayout="columnsLeftLarger";af.datasetActionsDisplay=aq;af.datasetsOwnerFilter={type:f};af.datasetHideDepartment=b;af.applicationsPage={type:ao};af.applicationsCardLayout=k;af.applicationsDirectNavigation=c;af.applicationActionsDisplay=aq;af.applicationsDefaultSort=ap;af.applicationHideDepartment=b;af.externalReusesPage={type:f};af.usesPage={type:f};af.usesManagement={type:"managers"};af.usesCardLayout=k;af.newsPage={type:f};af.eventsPage={type:f};af.contactEmail="cdo@ademe.fr";af.contactFooterColor=ak;af.networks=["twitter","linkedin","reddit","facebook","whatsapp"];af.personalNavigationColor=ah;af.personalAccountPages=[];af.personnalHidePages=[];af.analytics={type:f};af.updatedAt="2025-10-13T13:57:39.535Z";af.owner={type:u,id:v,name:w};ar._id="efWMeL1ZP";au[0]="organization:mMqHP1AmF";ax[0]={_id:"6a301167ab8168b8b75456b6",updated:{date:"2026-06-24T09:03:32.074Z"},navigation:{type:ay,position:az},template:aA,title:"Accès MCP",id:"acces-mcp"};ax[1]={_id:"6717558f1adfd05460cc16b2",updated:{date:"2024-11-05T14:53:01.669Z"},navigation:{type:ay,position:az},template:aA,title:"FAQ",id:"faq"};return {layout:t,data:[{}],fetch:{"0":{},"1":{isMobileOnly:c,dataset:{owner:{type:u,id:v,name:w,department:"dsrep",departmentName:"DSREP"},updatedAt:"2026-06-30T10:17:00.258Z",createdAt:"2025-05-27T09:48:54.211Z",updatedBy:{id:"apiKey:qehQ6oYerTmgAC2SDwvPh",name:"SYDEREP"},createdBy:{id:x,name:y},schema:[{key:z,"x-originalName":A,type:a,"x-cardinality":20,enum:["EMPAP","EEE","TLC","BAT","PMCB","EA","JOUET","ABJ","ASL","PNEU","PCHIM","EPRO","LUB","MNU","TSUU","BPS","DISP_MED","VEHICULE","TABAC","PAP"],description:d},{key:B,"x-originalName":C,type:a,"x-cardinality":205297,description:d},{key:D,"x-originalName":E,type:a,"x-cardinality":206066,description:d},{key:F,"x-originalName":G,type:a,"x-cardinality":195393,description:d},{key:H,"x-originalName":I,type:a,"x-cardinality":41636,description:d},{key:J,"x-originalName":K,type:a,"x-cardinality":4677,description:d},{key:L,"x-originalName":M,type:a,"x-cardinality":27769,description:d},{key:N,"x-originalName":O,type:a,"x-cardinality":41226,description:d},{key:P,"x-originalName":Q,type:a,"x-cardinality":112,description:d},{key:R,"x-originalName":S,type:l,"x-cardinality":T,enum:[38838007300162,82330882000039,48774196900033,53849587000031,39091301000042,83033936200022,50929280100024,90272217200035,42258207200043,91187025100012,53740637300036,75113994000025,44087413900023,97852364500015,80054749900023,90377711800022,95083360800017,39316301900044,93062626200024,51319280700032,79250555400032,92474564900013,89201535500027,92951020400019,98185638800013,81761178300033],description:d},{key:U,"x-originalName":V,type:a,"x-cardinality":T,enum:["CITEO","LEKO","ECOLOGIC","ECOMAISON","ADELPHE","ecosystem","REFASHION","VALOBAT","BATRIBOX","ECOMINERO","VALDELIA","EcoDDS","ALIAPUR","CITEO PRO","SOREN","CYCLEVIA","France Recyclage Pneumatique (FRP SAS)","CYCLAMED","CITEO Soin & Hygiène","Association pour la Plaisance Eco-Responsable","DASTRI","Recycler Mon Véhicule (RMV)","ALCOME","ECOPAE","TYVAL","PYRéO"],description:d},{key:W,"x-originalName":X,type:a,"x-cardinality":188,description:d},{key:Y,"x-originalName":Z,type:a,format:m,"x-cardinality":1410,description:d},{key:_,"x-originalName":$,type:a,format:m,"x-cardinality":aa,description:d},{"x-calculated":b,key:"_id",type:a,format:"uri-reference",title:"Identifiant",description:"\u003Cp\u003EIdentifiant unique parmi toutes les lignes du jeu de données\u003C\u002Fp\u003E"},{"x-calculated":b,key:"_i",type:l,title:"Numéro de ligne",description:"\u003Cp\u003EIndice de la ligne dans le fichier d'origine\u003C\u002Fp\u003E"},{"x-calculated":b,key:"_rand",type:l,title:"Nombre aléatoire",description:"\u003Cp\u003EUn nombre aléatoire associé à la ligne qui permet d'obtenir un tri aléatoire par exemple\u003C\u002Fp\u003E"}],title:"REP - Liste des membres adhérents des éco-organismes en fin d’année",status:"finalized",id:"7xrfi2s5qbywcv7ac-o6yf8z",slug:"rep-adherents-eo-fin-annee",count:267553,dataUpdatedAt:"2026-05-02T16:57:30.589Z",dataUpdatedBy:{id:x,name:y},description:"\u003Cp\u003ELe jeu de données comprend la mise à jour annuelle de la liste des adhérents des éco-organismes, conformément à l’article L. 541-10-14 du Code de l’environnement. Le jeu de données concerne les filières REP : ABJ, ASL, EEE, BPS, DISP-MED, EA, EMPAP, EPRO, JOUET, LUB, MNU, PA, PCHIM, PMCB, PNEU, TLC, TABAC, TSUU, VEHICULE.\u003C\u002Fp\u003E\n\u003Cp\u003EIl s’agit des adhésions valides au 31 décembre de chaque année. Dans le cas des adhésions qui se sont terminées au 31\u002F12, l’information est précisée dans la colonne sur la date de fin.\u003C\u002Fp\u003E\n\u003Cp\u003EPour utiliser ce jeu de données, téléchargez le \u003Ca href=\"https:\u002F\u002Fdata.ademe.fr\u002Fdata-fair\u002Fapi\u002Fv1\u002Fdatasets\u002F7xrfi2s5qbywcv7ac-o6yf8z\u002Fmetadata-attachments\u002FCodes_libell%C3%A9s_Liste_producteurs_SYDEREP.xlsx\"\u003E\u003Cstrong\u003Eréférentiel\u003C\u002Fstrong\u003E\u003C\u002Fa\u003E utilisé.\u003C\u002Fp\u003E\n\u003Cp\u003EEn complément de cette liste, l’ADEME met à disposition la liste des producteurs des filières à Responsabilité élargie du producteur (REP) enregistrés dans SYDEREP avec leur identifiant unique (IDU) : \u003Ca href=\"https:\u002F\u002Fdata.ademe.fr\u002Fdatasets\u002Frep-producteurs-idu\"\u003Econsulter la liste\u003C\u002Fa\u003E.\u003C\u002Fp\u003E\n\u003Cp\u003EPour le producteur, l’IDU est la preuve qu’il est bien enregistré au registre pour une filière, conformément à l’article L. 541-10-13 du Code de l'environnement. Pour l’ADEME, il sert à faciliter le suivi et le contrôle du respect des obligations de REP qui incombent à ces producteurs, ainsi qu’à identifier les producteurs en système individuel et les producteurs adhérents à un éco-organisme qui sont éligibles à la redevance annuelle. Ainsi, pour les filières en vigueur, le vendeur d'un produit relevant du principe de REP peut communiquer à l'acheteur, à la demande de ce dernier, l'IDU sous lequel est enregistré le producteur qui remplit pour ce produit les obligations de REP (cf. L. 541-10-10 du code de l'environnement).\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Ca href=\"https:\u002F\u002Fresponse.questback.com\u002Fdynamic\u002Fademe\u002Fxmz3vvsmmx\u002Fanswer?sid=mymRJpCTou&amp;Jeu=1\"\u003E\u003Cimg src=\"https:\u002F\u002Fimages.gitbook.com\u002F__img\u002Fdpr=2,width=760,onerror=redirect,format=auto,signature=1475354846\u002Fhttps%3A%2F%2Ffiles.gitbook.com%2Fv0%2Fb%2Fgitbook-x-prod.appspot.com%2Fo%2Fspaces%252F2jK8JaUieA84hk2TJR3v%252Fuploads%252Ft2DLqA9NGK6aJMaDyKzl%252FBanni%25C3%25A8reOpendataV2.png%3Falt%3Dmedia%26token%3D705526a8-910d-4739-8f7b-9191587d5d68\" alt=\"Donnez votre avis sur ce jeu de données\" \u002F\u003E\u003C\u002Fa\u003E\u003C\u002Fp\u003E\n\u003Ch3\u003E\u003Cstrong\u003ERègles d’actualisation des données\u003C\u002Fstrong\u003E\u003C\u002Fh3\u003E\n\u003Cp\u003ELes données sont actualisées à partir des mises à jour effectuées par les éco-organismes sur SYDEREP qui enregistrent leur liste d’adhérents. Pour les producteurs en système collectif, la suppression de l’IDU se fait à la seule initiative de l’éco-organisme qui a la responsabilité de cette décision. Cette liste ne reflète pas les producteurs qui ont effectué une déclaration de données sur SYDEREP.\u003C\u002Fp\u003E\n\u003Cp\u003EPoint d'attention : l'ouverture du fichier CSV dans Excel peut perturber l'affichage par défaut du SIRET et nécessiter de changer le format d'affichage de la colonne.\u003C\u002Fp\u003E\n\u003Cp\u003EL'ADEME a prévu une mise à jour trimestrielle de ce jeu de données au 31\u002F01, 30\u002F04, 31\u002F07 et 31\u002F10.\nLa date de la mise à jour est précisée sur l'étiquette du jeu de données. \u003C\u002Fp\u003E\n\u003Ch3\u003EGénéralités sur les filières REP\u003C\u002Fh3\u003E\n\u003Cp\u003EL’État a confié à l’ADEME la mise en place et la gestion des registres de déclarations annuelles obligatoires des metteurs sur le marché relevant des filières REP suivantes :\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003EArticle de bricolage et de jardinage (ABJ) ;\u003C\u002Fli\u003E\n\u003Cli\u003EArticles de sport et loisirs (ASL) ;\u003C\u002Fli\u003E\n\u003Cli\u003EBateaux de plaisance ou de sport (BPS) ;\u003C\u002Fli\u003E\n\u003Cli\u003EDispositifs Médicaux perforants des patients en auto-traitement (DISP-MED) ;\u003C\u002Fli\u003E\n\u003Cli\u003EEléments d’ameublement (EA) ;\u003C\u002Fli\u003E\n\u003Cli\u003EEquipements électriques et électroniques (EEE) ;\u003C\u002Fli\u003E\n\u003Cli\u003EEmballages ménagers et papiers graphiques (EMPAP) ;\u003C\u002Fli\u003E\n\u003Cli\u003EEmballages professionnels (EPRO) ;\u003C\u002Fli\u003E\n\u003Cli\u003EHuiles lubrifiantes ou industrielles (LUB) ;\u003C\u002Fli\u003E\n\u003Cli\u003EJouets (JOUET) ;\u003C\u002Fli\u003E\n\u003Cli\u003EMédicaments non utilisés (MNU) ;\u003C\u002Fli\u003E\n\u003Cli\u003EPiles et accumulateurs (PA) ;\u003C\u002Fli\u003E\n\u003Cli\u003EPneumatiques (PNEU) ;\u003C\u002Fli\u003E\n\u003Cli\u003EProduits chimiques (PCHIM) ;\u003C\u002Fli\u003E\n\u003Cli\u003EProduits ou matériaux de construction du secteur du bâtiment (PMCB) ;\u003C\u002Fli\u003E\n\u003Cli\u003EProduits du tabac (TABAC) ;\u003C\u002Fli\u003E\n\u003Cli\u003ETextiles d’habillement, linge de maison et chaussures (TLC) ;\u003C\u002Fli\u003E\n\u003Cli\u003EVoitures particulières, camionnettes, véhicules à moteurs à 2 ou 3 roues et quadricycles (VEHICULE).\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Cp\u003E\n\u003C\u002Fp\u003E\n\n\u003Cp\u003ECette liste va s’enrichir au fur et à mesure de l’entrée en vigueur de la loi AGEC avec les nouvelles filières à venir.\u003C\u002Fp\u003E\n\u003Cp\u003E\n\u003C\u002Fp\u003E\n\n\u003Cp\u003ECes registres sont gérés dans l’application \u003Ca href=\"https:\u002F\u002Fsyderep.ademe.fr\u002F\"\u003ESYDEREP\u003C\u002Fa\u003E, permettant aux éco-organismes ou aux producteurs en système individuel, le renseignement direct de leurs données.\u003C\u002Fp\u003E\n\u003Cp\u003ECes registres ayant pour objet la mesure de la performance globale au niveau national de chacune des filières REP, l’ADEME établit et publie annuellement un état des lieux des filières et différentes publications avec un certain nombre d’indicateurs agrégés, complétés d'éléments d'analyses qualitatives provenant des acteurs de chaque filière.\u003C\u002Fp\u003E\n\u003Ch3\u003EJeux de données disponibles sur les filières REP\u003C\u002Fh3\u003E\n\u003Cp\u003EDes données issues de ces registres sont aujourd’hui disponibles sur \u003Ca href=\"https:\u002F\u002Fdata.ademe.fr\u002F\"\u003Ehttps:\u002F\u002Fdata.ademe.fr\u003C\u002Fa\u003E :\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003ELa liste des producteurs enregistrés dans SYDEREP avec leur identifiant unique ;\u003C\u002Fli\u003E\n\u003Cli\u003ELa liste des membres adhérents des éco-organismes. La mise à jour de cette liste a lieu une fois par an, en juin de chaque année ;\u003C\u002Fli\u003E\n\u003Cli\u003ELes quantités mises sur le marché pour les filières BPS, DISPMED, EA, EEE, EMBM, LUB, MNU, PA, PAP, PCHIM, PNEU, TABAC et TLC ;\u003C\u002Fli\u003E\n\u003Cli\u003ELes tonnages collectés pour les filières BPS, DISPMED, EA, EEE,MNU, PA, PCHIM, PNEU, TLC et VEHICULE.\nainsi que certains indicateurs, au fur et à mesure de leur mise à disposition.\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Cp\u003E\n\u003C\u002Fp\u003E\n\n\u003Cp\u003E\u003Cstrong\u003ERetrouvez l'ensemble des \u003Ca href=\"https:\u002F\u002Ffilieres-rep.ademe.fr\u002Ffilieres-REP\"\u003Eressources disponibles des filières REP\u003C\u002Fa\u003E sur le site dédié \u003Ca href=\"https:\u002F\u002Ffilieres-rep.ademe.fr\u002F\"\u003Efilieres-rep.ademe.fr\u003C\u002Fa\u003E\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E",file:{name:p,size:n,mimetype:q,encoding:ab,schema:[{key:z,"x-originalName":A,type:a},{key:B,"x-originalName":C,type:a},{key:D,"x-originalName":E,type:a},{key:F,"x-originalName":G,type:a},{key:H,"x-originalName":I,type:a},{key:J,"x-originalName":K,type:a},{key:L,"x-originalName":M,type:a},{key:N,"x-originalName":O,type:a},{key:P,"x-originalName":Q,type:a},{key:R,"x-originalName":S,type:l},{key:U,"x-originalName":V,type:a},{key:W,"x-originalName":X,type:a},{key:Y,"x-originalName":Z,type:a,format:m},{key:_,"x-originalName":$,type:a,format:m}],props:{linesDelimiter:"\r\n",fieldsDelimiter:";",escapeChar:ac,quote:ac}},finalizedAt:"2026-05-02T17:02:17.049Z",frequency:"annual",license:{href:"https:\u002F\u002Fwww.etalab.gouv.fr\u002Flicence-ouverte-open-licence",title:"Licence Ouverte \u002F Open Licence version 2.0"},origin:"ADEME \u002F Syderep",originalFile:{name:p,size:n,mimetype:q,encoding:ab},topics:[{title:"Economie circulaire et déchets",color:"#0070C0FF",id:"d2-r8c-q5eow8euuircng9bp",icon:{name:"trash-can-outline",svgPath:"M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"}}],storage:{size:45747375,dataFiles:[{name:p,key:"original",title:"Fichier d'origine",mimetype:q,size:n,updatedAt:"2026-05-02T17:02:20.000Z"}],indexed:{size:n,parts:["original-file"]},attachments:{size:h,count:h},metadataAttachments:{size:ad,count:aa},masterData:{size:h,count:h}},attachments:[{type:"file",includeInCatalogPublications:c,description:"\u003Cp\u003ERéférentiel des codes Filières et codes Organisation utilisés dans le jeu de données.\u003C\u002Fp\u003E",title:ae,name:ae,size:ad,mimetype:"application\u002Fvnd.openxmlformats-officedocument.spreadsheetml.sheet",updatedAt:"2025-05-27T10:06:47.124Z",url:"https:\u002F\u002Fdata.ademe.fr\u002Fdata-fair\u002Fapi\u002Fv1\u002Fdatasets\u002F7xrfi2s5qbywcv7ac-o6yf8z\u002Fmetadata-attachments\u002FCodes_libellés_Liste_producteurs_SYDEREP.xlsx"}],requestedPublicationSites:[],spatial:"France entière",publicationSites:["data-fair-portals:efWMeL1ZP","data-fair-portals:d60479cb-366f-4dc4-9f3f-1e9dd1a76c97"],publications:[],keywords:["REP ","Déchets"],userPermissions:["list","readDescription","readSchema","readSafeSchema","readLines","getGeoAgg","getValuesAgg","getValues","getMetricAgg","getSimpleMetricsAgg","getWordsAgg","getMinAgg","getMaxAgg","downloadOriginalData","downloadFullData","readApiDoc","realtime-transactions","readLine","readLineRevisions","readRevisions","bulkSearch","listDataFiles","downloadDataFile","downloadMetadataAttachment","downloadAttachment","getReadApiKey","readCompatODSRecords","readCompatODSExports"],public:b,visibility:"public",previews:[{id:"table",title:"Tableau",href:"https:\u002F\u002Fdata.ademe.fr\u002Fdata-fair\u002Fembed\u002Fdataset\u002Frep-adherents-eo-fin-annee\u002Ftable"}],href:"https:\u002F\u002Fdata.ademe.fr\u002Fdata-fair\u002Fapi\u002Fv1\u002Fdatasets\u002Frep-adherents-eo-fin-annee",page:"https:\u002F\u002Fdata.ademe.fr\u002Fdatasets\u002Frep-adherents-eo-fin-annee"},applications