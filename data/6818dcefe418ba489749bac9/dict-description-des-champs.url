FF","ILE-DE-BATZ","SAINT-CAST-LE-GUILDO","LANVEOC","OUESSANT","ILE-DE-BREHAT","BLAIN","BLERUAIS","CAMARET-SUR-MER","CORAY","FOUGERES","GUEMENE-PENFAO","LA NOE-BLANCHE","LANNION","LES LOGES-MARCHIS","MERDRIGNAC","MEZIERES-SUR-COUESNON","NOZAY","PENMARCH","PLERGUER","PLEYBER-CHRIST","PLOERMEL","PLOUDALMEZEAU","PLUSQUELLEC","RENNES","SAINT-CLEMENT-RANCOUDRAY","SAINTE-MARIE","SENE","VAL-D'IZE"],description:"\u003Cp\u003Ecommune sur laquelle est située la station Météo France\u003C\u002Fp\u003E"},{key:q,"x-originalName":q,type:c,"x-cardinality":S,enum:["rr","tmm","tx25d","tx30d","tx90p","wsdi","tnfd","tnltm2","txge35","cdd","hdd","tr","r20mm","rrinf1","rrsup1","sech_rr"],description:"\u003Cp\u003Ecode de l'indicateur\u003C\u002Fp\u003E"},{key:r,"x-originalName":r,type:c,"x-cardinality":S,enum:["cumul de précipitation (mm)","température moyenne journalière (°c)","durée des vagues de chaleur","nombre de journées chaudes (jour(s))","nombre de jours anormalement chauds","nombre de jours de fortes chaleur ( tx\u003E30°c ) (jour(s))","nombre de jours de gel (jour(s))","nombre de jours où Tmax\u003E=35°C","nombre de jours où la température minimale est inférieure à -2°C","besoin en refroidissement des batiments","besoins en chauffage des batiments","nombre de nuits chaudes (jour(s))","durée de la période de sécheresse météorologique","nombre de jours de fortes pluies","nombre de jours de pluie","nombre de jours sans pluie (jour(s))"],description:"\u003Cp\u003Elibellé de l'indicateur\u003C\u002Fp\u003E"},{key:s,"x-originalName":s,type:c,"x-cardinality":T,enum:["sh","sqr"],description:"\u003Cp\u003Eindique si l'indicateur provient de séries homogénéisées (SH) ou de séries quotidiennes de référence (SQR)\u003C\u002Fp\u003E"},{key:t,"x-originalName":t,type:c,"x-cardinality":T,enum:["1961-2014","1961-2022"],description:"\u003Cp\u003Epériode sur laquelle est calculée la tendance climatique, soit 1961-2014, soit 1961-2022\u003C\u002Fp\u003E"},{key:u,"x-originalName":u,type:c,"x-cardinality":5,enum:["ann","aut","ete","hiv","pri"],description:"\u003Cp\u003Esaison sur laquelle est calculé l'indicateur, soit année soit printemps, été, automne ou hiver\u003C\u002Fp\u003E"},{key:v,"x-originalName":v,type:e,"x-cardinality":335,description:"\u003Cp\u003Etendance (en unité de l'indicateur par décennie)\u003C\u002Fp\u003E"},{key:w,"x-originalName":w,type:e,"x-cardinality":239,description:"\u003Cp\u003Ep-value, défini la significativité statistique de la tendance (si p-value≤0,05 la tendance est significative)\u003C\u002Fp\u003E"},{key:x,"x-originalName":x,type:c,format:U,"x-cardinality":V,enum:["2025-02-10T00:00:00.000Z"],description:"\u003Cp\u003Edate de dernière mise à jour\u003C\u002Fp\u003E"},{key:y,"x-originalName":y,type:c,"x-cardinality":V,enum:["Météo-France, traitement OEB"],description:"\u003Cp\u003Esource des données\u003C\u002Fp\u003E"},{"x-calculated":b,key:"_id",type:c,format:"uri-reference",title:"Identifiant",description:"\u003Cp\u003EIdentifiant unique parmi toutes les lignes du jeu de données\u003C\u002Fp\u003E"},{"x-calculated":b,key:"_i",type:h,title:"Numéro de ligne",description:"\u003Cp\u003EIndice de la ligne dans le fichier d'origine\u003C\u002Fp\u003E"},{"x-calculated":b,key:"_rand",type:h,title:"Nombre aléatoire",description:"\u003Cp\u003EUn nombre aléatoire associé à la ligne qui permet d'obtenir un tri aléatoire par exemple\u003C\u002Fp\u003E"}],status:"finalized",dataUpdatedBy:{id:E,name:F},dataUpdatedAt:P,id:"yums-392tpl45q1vsl8uwr01",slug:"indicateurs-climat-passe-tendances-climatiques-en-bretagne-par-station-meteo",storage:{size:j,dataFiles:[{name:G,key:"original",title:"Fichier d'origine",mimetype:H,size:j,updatedAt:"2025-02-24T14:21:02.896Z"}],indexed:{size:j,parts:["original-file"]},attachments:{size:f,count:f},metadataAttachments:{size:f,count:f},masterData:{size:f,count:f}},file:{name:G,size:j,mimetype:H,md5:W,encoding:X,schema:[{key:k,"x-originalName":k,type:h},{key:m,"x-originalName":m,type:e},{key:n,"x-originalName":n,type:e},{key:o,"x-originalName":o,type:h},{key:p,"x-originalName":p,type:c},{key:q,"x-originalName":q,type:c},{key:r,"x-originalName":r,type:c},{key:s,"x-originalName":s,type:c},{key:t,"x-originalName":t,type:c},{key:u,"x-originalName":u,type:c},{key:v,"x-originalName":v,type:e},{key:w,"x-originalName":w,type:e},{key:x,"x-originalName":x,type:c,format:U,dateFormat:"D\u002FM\u002FYYYY"},{key:y,"x-originalName":y,type:c}],props:{linesDelimiter:"\r\n",fieldsDelimiter:";",escapeChar:Y,quote:Y}},originalFile:{name:G,size:j,mimetype:H,md5:W,encoding:X},count:413,finalizedAt:"2025-02-24T14:21:30.985Z",license:{href:"https:\u002F\u002Fwww.etalab.gouv.fr\u002Flicence-ouverte-open-licence",title:"Licence Ouverte \u002F Open Licence version 2.0"},topics:[{title:"Changement climatique",color:"#4C3C90FF",id:"C1AYh7kCk3Xfi-tEXo9uR"}],origin:Z,spatial:"Bretagne",temporal:{start:"1961-01-01",end:"2022-12-31"},frequency:"irregular",description:"\u003Cp\u003EIndicateurs de tendances climatiques par décennie sur un ensemble de stations Météo France, à partir de séries homogénéisées et de séries quotidiennes de référence. Les tendances sont calculées sur la période 1961-2014 et quand cela est possible, également sur la période 1961-2022. La position des stations Météo France est fournie avec le système de coordonnées WSG84. Les stations sélectionnées couvrent la Bretagne et les SAGE bretons.\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003ESources :\u003C\u002Fstrong\u003E Météo France, 2024. Traitement : OEB, 2025. Accéder au jeu de données brutes sur le site des \u003Ca href=\"https:\u002F\u002Fmeteo.data.gouv.fr\u002Fdatasets?topic=6571f2db0273fc306408f265\" target=\"_blank\"\u003Edonnées publiques météorologiques produites par Météo-France.\u003C\u002Fa\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003ENote 1 :\u003C\u002Fstrong\u003E pourquoi il n'y a pas de station sur mon territoire ? Ce jeu de données concerne les stations de référence Météo France pour la climatologie, c’est-à-dire uniquement des stations météo disposant de données depuis au moins 1961, jugées suffisamment fiable par Météo-France. Ces stations sont rares en Bretagne et historiquement surtout situées dans les ports.\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003ENote 2 :\u003C\u002Fstrong\u003E cette donnée est associée à la donnée \u003Ca href=\"https:\u002F\u002Fdata.bretagne-environnement.fr\u002Fdatasets\u002Findicateurs-climat-passe-indicateurs-annuels-en-bretagne-par-station-meteo\" target=\"_blank\"\u003EIndicateurs climat passé : indicateurs annuels en Bretagne par station météo\u003C\u002Fa\u003E qui fournit les séries chronologiques annuelles de chaque indicateur entre 1961 et 2022. \u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003EAller plus loin :\u003C\u002Fstrong\u003E consulter la datavisualisation \u003Ca href=\"https:\u002F\u002Fbretagne-environnement.fr\u002Ftableau-de-bord\u002Ftendances-climatiques-passe-adaptation-climat-bretagne\" target=\"_blank\"\u003EClimat passé - Tendances climatiques sur les stations de référence Météo France\u003C\u002Fa\u003E réalisée par l'OEB et la méthodologie et les sources détaillées dans la \u003Ca href=\"https:\u002F\u002Fdoc-data-oeb.readthedocs.io\u002Ffr\u002Flatest\u002Fclimat\u002F3_doc_donnees_stations_meteo_france\u002F\" target=\"_blank\"\u003Edocumentation méthodologique.\u003C\u002Fa\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cimg src=\"https:\u002F\u002Fbretagne-environnement.fr\u002Fsites\u002Fdefault\u002Ffiles\u002F2024-11\u002FEurope_s_engage_RVB_xxxs%20-%20Copie.jpg\" alt=\"\" \u002F\u003E      La mission adaptation\u002Fclimat de l'OEB, cofinancée par l'Union européenne, a pour objectif de mettre à disposition des indicateurs et connaissances de référence sur le changement climatique passé et futur, et ses impacts en Bretagne, aux territoires bretons et au grand public.\u003C\u002Fp\u003E",publicationSites:["data-fair-portals:q7t7yA-Mo"],requestedPublicationSites:[],publications:[],userPermissions:["list","readDescription","readSchema","readSafeSchema","readLines","getGeoAgg","getValuesAgg","getValues","getMetricAgg","getSimpleMetricsAgg","getWordsAgg","getMinAgg","getMaxAgg","downloadOriginalData","downloadFullData","readApiDoc","realtime-transactions","readLine","readLineRevisions","readRevisions","bulkSearch","listDataFiles","downloadDataFile","downloadMetadataAttachment","downloadAttachment","getReadApiKey","readCompatODSRecords","readCompatODSExports"],public:b,visibility:"public",previews:[{id:"table",title:"Tableau",href:"https:\u002F\u002Fdata.bretagne-environnement.fr\u002Fdata-fair\u002Fembed\u002Fdataset\u002Findicateurs-climat-passe-tendances-climatiques-en-bretagne-par-station-meteo\u002Ftable"}],href:"https:\u002F\u002Fdata.bretagne-environnement.fr\u002Fdata-fair\u002Fapi\u002Fv1\u002Fdatasets\u002Findicateurs-climat-passe-tendances-climatiques-en-bretagne-par-station-meteo",page:"https:\u002F\u002Fdata.bretagne-environnement.fr\u002Fdatasets\u002Findicateurs-climat-passe-tendances-climatiques-en-bretagne-par-station-meteo"},applications:{count:f,results:[]},uses:[{_id:"1KxOilG6bbf7jHe4mSJnk",title:"Datavisualisations interactives de l'OEB",owner:{type:B,id:C,name:D},slug:"datavisualisation",published:b,publishedAt:"2022-10-13T14:32:54.076Z",author:Z,image:{name:"vignette datavisualisation 2.jpg",type:"image\u002Fjpeg",size:227409}}]}},error:d,state:{config:_,portal:al,draft:a,initialQuery:am,textDark:"#212121",breadcrumbs:d,publicUrl:A,publicBaseUrl:A,mainPublicUrl:an,html:b,inPortal:b,concepts:d,userPartners:d,whiteLabelOwners:ao,childBreadcrumbsRouteName:d,childBreadcrumbItems:d,processingsBasePath:ap,notifyBasePath:aq,pageImages:{},navigation:{pages:ar,datasetsList:d,applicationsList:d,usesList:d,publicUrl:A,publicBaseUrl:A,mainPublicUrl:an,processingsBasePath:ap,notifyBasePath:aq,initialQuery:am,draft:a,portal:al,html:b,inPortal:b,config:_,whiteLabelOwners:ao},style:{},session:{user:d,initialized:b,directoryUrl:"https:\u002F